<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title ? title : 'ASSGA - Associação dos Surdos de São Gonçalo do Amarante' %></title>
    <meta name="description" content="Portal oficial da ASSGA: história, estatuto social, diretoria, departamento esportivo, eventos, carteirinha e área do associado.">
    <link rel="icon" type="image/jpeg" href="/imagens/Assga_foto.jpg">
    <link rel="apple-touch-icon" href="/imagens/Assga_foto.jpg">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <style>
        :root {
            --assga-blue: #0d3d8f;
            --assga-blue-mid: #1a63d0;
            --assga-blue-dark: #10264a;
            --assga-light-blue: #edf4ff;
            --assga-red: #d93d3d;
            --assga-green: #198754;
            --assga-yellow: #f4b400;
            --assga-white: #ffffff;
            --assga-gray: #5b6c86;
            --bs-primary: #0d3d8f;
            --bs-secondary: #1a63d0;
            --bs-success: #198754;
            --bs-info: #1a63d0;
            --bs-warning: #f4b400;
            --bs-danger: #d93d3d;
            --bs-light: #ffffff;
            --bs-dark: #10264a;
            --bs-body-color: #10264a;
            --bs-secondary-color: #5b6c86;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        body.admin-theme {
            --admin-bg: #f4f9ff;
            --admin-panel: #ffffff;
            --admin-panel-alt: #edf6ff;
            --admin-text: #1f3762;
            --admin-muted: #51698d;
            --admin-border: #d7e7ff;
            --admin-accent: #0d3d8f;
            --admin-accent-2: #1e5fd4;
            --admin-soft: #edf5ff;
            background: linear-gradient(180deg, #f7fbff 0%, #edf5ff 100%);
            color: var(--admin-text);
        }
        body.admin-theme .navbar-assga {
            background: linear-gradient(135deg, #0a2f63 0%, #0d4aa4 46%, #1b6de2 100%);
            box-shadow: 0 10px 26px rgba(13, 61, 143, 0.22);
        }
        body.admin-theme .sticky-top {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            z-index: 1020;
        }
        body.admin-theme .navbar-dark,
        body.admin-theme .navbar[data-bs-theme=dark] {
            --bs-navbar-color: rgba(255, 255, 255, 0.55);
            --bs-navbar-hover-color: rgba(255, 255, 255, 0.75);
            --bs-navbar-disabled-color: rgba(255, 255, 255, 0.25);
            --bs-navbar-active-color: #fff;
            --bs-navbar-brand-color: #fff;
            --bs-navbar-brand-hover-color: #fff;
            --bs-navbar-toggler-border-color: rgba(255, 255, 255, 0.1);
            --bs-navbar-toggler-icon-bg: url(data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.55%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e);
        }
        body.admin-theme .card,
        body.admin-theme .table,
        body.admin-theme .alert,
        body.admin-theme .form-control,
        body.admin-theme .form-select,
        body.admin-theme .input-group-text,
        body.admin-theme .modal-content,
        body.admin-theme .dropdown-menu {
            background-color: var(--admin-panel);
            color: var(--admin-text);
            border-color: var(--admin-border);
        }
        body.admin-theme .card,
        body.admin-theme .table,
        body.admin-theme .alert,
        body.admin-theme .modal-content,
        body.admin-theme .dropdown-menu {
            box-shadow: 0 14px 28px rgba(34, 70, 122, 0.08) !important;
            border: 1px solid rgba(169, 196, 255, 0.45);
        }
        body.admin-theme .table-light,
        body.admin-theme .bg-light,
        body.admin-theme .bg-white,
        body.admin-theme .table thead th {
            background: linear-gradient(180deg, #f6fbff 0%, #edf5ff 100%) !important;
            color: var(--admin-text) !important;
        }
        body.admin-theme .table thead th {
            border-bottom: 1px solid var(--admin-border);
            font-weight: 700;
            letter-spacing: 0.02em;
        }
        body.admin-theme .text-primary,
        body.admin-theme .text-secondary,
        body.admin-theme .text-success,
        body.admin-theme .text-info,
        body.admin-theme .text-warning,
        body.admin-theme .text-danger,
        body.admin-theme .text-dark,
        body.admin-theme .fw-bold,
        body.admin-theme h1,
        body.admin-theme h2,
        body.admin-theme h3,
        body.admin-theme h4,
        body.admin-theme h5,
        body.admin-theme h6 {
            color: var(--admin-text) !important;
            font-weight: 700 !important;
        }
        body.admin-theme .text-muted,
        body.admin-theme .small,
        body.admin-theme .form-label,
        body.admin-theme .nav-link.text-dark,
        body.admin-theme .nav-link:not(.active) {
            color: var(--admin-muted) !important;
        }
        body.admin-theme .btn-primary,
        body.admin-theme .btn-success,
        body.admin-theme .btn-info,
        body.admin-theme .btn-secondary,
        body.admin-theme .btn-dark,
        body.admin-theme .bg-primary,
        body.admin-theme .bg-success,
        body.admin-theme .bg-info,
        body.admin-theme .bg-secondary,
        body.admin-theme .nav-pills .nav-link.active,
        body.admin-theme .badge.bg-primary,
        body.admin-theme .badge.bg-success,
        body.admin-theme .badge.bg-info,
        body.admin-theme .badge.bg-secondary {
            background: linear-gradient(135deg, #0d3d8f 0%, #1e5fd4 100%) !important;
            border-color: #0d3d8f !important;
            color: #ffffff !important;
            box-shadow: 0 8px 18px rgba(13, 61, 143, 0.18);
        }
        body.admin-theme .btn-warning,
        body.admin-theme .bg-warning,
        body.admin-theme .badge.bg-warning {
            background: linear-gradient(135deg, #f7b500 0%, #ffd11a 100%) !important;
            border-color: #f7b500 !important;
            color: #1d2d3d !important;
        }
        body.admin-theme .btn-danger,
        body.admin-theme .bg-danger,
        body.admin-theme .badge.bg-danger {
            background: linear-gradient(135deg, #d90000 0%, #ff2d2d 100%) !important;
            border-color: #d90000 !important;
            color: #ffffff !important;
        }
        body.admin-theme .btn-outline-primary,
        body.admin-theme .btn-outline-secondary,
        body.admin-theme .btn-outline-success,
        body.admin-theme .btn-outline-warning,
        body.admin-theme .btn-outline-danger,
        body.admin-theme .btn-outline-dark {
            background-color: transparent !important;
            border-color: #0d3d8f !important;
            color: #0d3d8f !important;
        }
        body.admin-theme .btn-outline-primary:hover,
        body.admin-theme .btn-outline-secondary:hover,
        body.admin-theme .btn-outline-success:hover,
        body.admin-theme .btn-outline-warning:hover,
        body.admin-theme .btn-outline-danger:hover,
        body.admin-theme .btn-outline-dark:hover {
            background: linear-gradient(135deg, #0d3d8f 0%, #3e7de0 100%) !important;
            border-color: #0d3d8f !important;
            color: #ffffff !important;
        }
        body.admin-theme .bg-primary-subtle,
        body.admin-theme .badge.bg-light,
        body.admin-theme .badge.bg-light.text-primary,
        body.admin-theme .border-primary-subtle {
            background-color: #eef8ff !important;
            color: #0d3d8f !important;
            border-color: #d7eaff !important;
        }
        body.admin-theme .nav-link {
            color: #0d3d8f !important;
        }
        body.admin-theme .nav-link.active {
            background: linear-gradient(135deg, #0d3d8f 0%, #1d6fe8 100%) !important;
            color: #ffffff !important;
            box-shadow: 0 8px 18px rgba(13, 61, 143, 0.2);
        }
        body.admin-theme .nav-pills .nav-link {
            background: linear-gradient(180deg, #ffffff 0%, #f4f9ff 100%);
            color: #123d78;
            border: 1px solid #d5e5ff;
            transition: all 0.2s ease;
            font-weight: 700;
        }
        body.admin-theme .nav-pills .nav-link:hover {
            border-color: #b8d4ff;
            background: linear-gradient(180deg, #f8fbff 0%, #edf5ff 100%);
            transform: translateY(-1px);
        }
        body.admin-theme .nav-pills .nav-link.active {
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
        }
        body.admin-theme .border,
        body.admin-theme .border-top,
        body.admin-theme .border-bottom,
        body.admin-theme .border-start,
        body.admin-theme .border-end {
            border-color: var(--admin-border) !important;
        }
        body.admin-theme .badge {
            border-color: transparent;
        }
        body.admin-theme .form-control::placeholder,
        body.admin-theme .form-select::placeholder {
            color: #7187a5;
        }
        body.admin-theme .table td,
        body.admin-theme .table th {
            color: var(--admin-text);
            border-color: var(--admin-border);
            vertical-align: middle;
        }
        .alert-success {
            background: linear-gradient(135deg, #1b9d65 0%, #2bc77d 100%);
            border-color: #1b9d65;
            color: #ffffff;
        }
        .alert-warning {
            background: linear-gradient(135deg, #f7b500 0%, #ffd11a 100%);
            border-color: #f7b500;
            color: #1d2d3d;
        }
        .alert-danger {
            background: linear-gradient(135deg, #d90000 0%, #ff2d2d 100%);
            border-color: #d90000;
            color: #ffffff;
        }
        .alert-dismissible .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
        .navbar-assga {
            background: linear-gradient(135deg, #0a2f63 0%, #0d4aa4 46%, #1b6de2 100%);
            box-shadow: 0 10px 26px rgba(13, 61, 143, 0.22);
        }
        .navbar-brand img {
            max-height: 48px;
            border-radius: 4px;
        }
        .nav-link {
            color: rgba(255, 255, 255, 0.9) !important;
            font-weight: 600;
            padding: 8px 14px !important;
            border-radius: 20px;
            transition: all 0.2s;
        }
        .nav-link:hover, .nav-link.active {
            color: #003366 !important;
            background-color: var(--assga-white);
        }
        .btn-accent {
            background: linear-gradient(135deg, #d93d3d 0%, #ef4e4e 100%);
            color: var(--assga-white);
            font-weight: 700;
            border: none;
            box-shadow: 0 8px 18px rgba(217, 61, 61, 0.2);
        }
        .btn-accent:hover {
            background: linear-gradient(135deg, #c62d2d 0%, #d93d3d 100%);
            color: var(--assga-white);
        }
        .footer-assga {
            background-color: #001f3f;
            color: var(--assga-white);
            margin-top: auto;
        }
        .badge-libras {
            background-color: var(--assga-red);
            color: var(--assga-white);
            font-size: 0.8rem;
            padding: 4px 10px;
            border-radius: 12px;
        }
    </style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : '' %>">

    <!-- Navegação Principal -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-assga sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <img src="/imagens/Assga_foto.jpg" alt="Logo da ASSGA">
                <span class="fw-bold text-white fs-3">ASSGA</span>
                <span class="d-none d-md-inline text-white-50 fs-6 border-start ps-2">Portal dos Surdos</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/"><i class="fa-solid fa-house me-1"></i> Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'historia' ? 'active' : '' %>" href="/historia"><i class="fa-solid fa-book-open me-1"></i> História</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'estatuto' ? 'active' : '' %>" href="/estatuto"><i class="fa-solid fa-scale-balanced me-1"></i> Estatuto</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'diretoria' ? 'active' : '' %>" href="/diretoria"><i class="fa-solid fa-users me-1"></i> Diretoria</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'esportiva' ? 'active' : '' %>" href="/esportiva"><i class="fa-solid fa-futbol me-1"></i> Esportes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'evento' ? 'active' : '' %>" href="/eventos"><i class="fa-solid fa-calendar me-1"></i> Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'pagamento' ? 'active' : '' %>" href="/pagamento"><i class="fa-solid fa-hand-holding-dollar me-1"></i> PIX</a>
                    </li>

                    <% if (user) { %>
                    <li class="nav-item">
                        <a class="nav-link <%= activePage === 'carteirinha' ? 'active' : '' %>" href="/carteirinha"><i class="fa-solid fa-id-card me-1"></i> Carteirinha</a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-warning btn-sm fw-bold" href="/area-associado"><i class="fa-solid fa-user-check me-1"></i> <%= user.nome.split(' ')[0] %></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-warning" href="/logout" title="Sair"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
                    </li>
                    <% } else { %>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-outline-light btn-sm px-3 rounded-pill fw-bold" href="/login"><i class="fa-solid fa-right-to-bracket me-1"></i> Entrar</a>
                    </li>
                    <% } %>
                    <% const isAdminView = String(typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : '').includes('admin-theme') || String(typeof activePage !== 'undefined' && activePage ? activePage : '').startsWith('admin'); %>
                    <% if (!isAdminView) { %>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
    <div class="container mt-3">
        <% messages.forEach(function(msg) { %>
        <div class="alert alert-<%= msg.type || 'info' %> alert-dismissible fade show" role="alert">
            <%= msg.text %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% }); %>
    </div>
    <% } %>

    <main class="flex-grow-1 py-4">
