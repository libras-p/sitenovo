<%- include('../layout/header') %>

<div class="container py-2">
    <%- include('nav_tabs') %>

    <!-- Cabeçalho -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-id-card-clip me-2"></i>Gestão de Carteirinhas Digitais e QR Code</h4>
                <p class="text-muted small mb-0">Controle de emissão, validade da anuidade e validação eletrônica da ASSGA.</p>
            </div>
            <div>
                <a href="/carteirinha" target="_blank" class="btn btn-outline-primary rounded-pill px-3 fw-bold">
                    <i class="fa-solid fa-eye me-1"></i> Modelo de Impressão
                </a>
            </div>
        </div>
    </div>

    <!-- Tabela de Carteirinhas -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Associado</th>
                        <th>Matrícula</th>
                        <th>Código QR de Autenticação</th>
                        <th>Emissão</th>
                        <th>Validade</th>
                        <th>Via</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (carteirinhas && carteirinhas.length > 0) { %>
                        <% carteirinhas.forEach(function(c) { %>
                        <% const assoc = associadosMap[c.associado_id]; %>
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark"><%= assoc ? assoc.nome : 'Associado #' + c.associado_id %></div>
                                <div class="text-muted small"><%= assoc ? assoc.categoria : '-' %></div>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border font-monospace"><%= assoc ? assoc.matricula : '-' %></span>
                            </td>
                            <td>
                                <a href="/validar/<%= c.codigo_autenticacao %>" target="_blank" class="font-monospace text-decoration-none fw-bold small text-primary" title="Clique para verificar autenticidade">
                                    <i class="fa-solid fa-qrcode me-1 text-secondary"></i> <%= c.codigo_autenticacao %>
                                </a>
                            </td>
                            <td class="small"><%= c.data_emissao.split('-').reverse().join('/') %></td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">
                                    <%= c.data_validade.split('-').reverse().join('/') %>
                                </span>
                            </td>
                            <td><span class="badge bg-secondary"><%= c.via %>ª Via</span></td>
                            <td>
                                <form method="post" action="/admin/carteirinhas/<%= c.id %>/toggle" class="d-inline">
                                    <% if (c.ativa) { %>
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" title="Clique para suspender">
                                        <i class="fa-solid fa-circle-check me-1"></i> Ativa
                                    </button>
                                    <% } else { %>
                                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold" title="Clique para reativar">
                                        <i class="fa-solid fa-ban me-1"></i> Suspensa
                                    </button>
                                    <% } %>
                                </form>
                            </td>
                            <td class="text-end pe-4">
                                <form method="post" action="/admin/carteirinhas/<%= c.id %>/excluir" class="d-inline" onsubmit="return confirm('Deseja realmente excluir esta carteirinha?');">
                                    <button type="submit" class="btn btn-sm btn-danger fw-bold px-3" title="Excluir Carteirinha">
                                        <i class="fa-solid fa-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                Nenhuma carteirinha cadastrada.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
