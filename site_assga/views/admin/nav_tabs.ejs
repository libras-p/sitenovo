<!-- Sub-navegação do Painel Administrativo ASSGA -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-danger text-white px-2 py-1 rounded-pill small fw-bold text-uppercase">
                    <i class="fa-solid fa-shield-halved me-1"></i> Gestão Interna
                </span>
                <h4 class="fw-bold text-primary mb-0">Painel Administrativo ASSGA</h4>
            </div>
            <p class="text-muted small mb-0 mt-1">Gerenciamento de sócios, carteirinhas com QR Code, mensalidades e eventos.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-globe me-1"></i> Ver Portal Público
            </a>
            <a href="/logout" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                <i class="fa-solid fa-power-off me-1"></i> Sair
            </a>
        </div>
    </div>

    <hr class="my-3 opacity-25">

    <ul class="nav nav-pills gap-2 flex-wrap">
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'dashboard' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin">
                <i class="fa-solid fa-chart-pie me-1"></i> Visão Geral
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'associados' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/associados">
                <i class="fa-solid fa-users me-1"></i> Lista de Associados
                <span class="badge <%= activeAdminTab === 'associados' ? 'bg-warning text-dark' : 'bg-secondary' %> ms-1"><%= totalAssociados %></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'mensalidades' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/mensalidades">
                <i class="fa-solid fa-receipt me-1"></i> Mensalidades
                <span class="badge <%= activeAdminTab === 'mensalidades' ? 'bg-warning text-dark' : 'bg-secondary' %> ms-1"><%= totalMensalidades %></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'carteirinhas' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/carteirinhas">
                <i class="fa-solid fa-id-card me-1"></i> Carteirinhas & QR
                <span class="badge <%= activeAdminTab === 'carteirinhas' ? 'bg-warning text-dark' : 'bg-secondary' %> ms-1"><%= totalCarteirinhas %></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'eventos' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/eventos">
                <i class="fa-solid fa-calendar-days me-1"></i> Eventos
                <span class="badge <%= activeAdminTab === 'eventos' ? 'bg-warning text-dark' : 'bg-secondary' %> ms-1"><%= totalEventos %></span>
            </a>
        </li>
    </ul>
</div>
