<!-- Sub-navegação do Painel Administrativo ASSGA -->
<div class="card border-0 rounded-4 p-3 mb-4" style="background: linear-gradient(180deg, rgba(245,249,255,0.98) 0%, rgba(234,244,255,0.98) 100%); box-shadow: 0 16px 32px rgba(13, 61, 143, 0.10); border: 1px solid rgba(130, 170, 255, 0.42);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge px-2 py-1 rounded-pill small fw-bold text-uppercase" style="background: linear-gradient(135deg, #0a2f63 0%, #0d4aa4 46%, #1b6de2 100%); color: #fff; border: 1px solid rgba(255,255,255,0.2);">
                    <i class="fa-solid fa-shield-halved me-1"></i> Gestão Interna
                </span>
                <h4 class="fw-bold mb-0" style="color: #123d78;">Painel Administrativo ASSGA</h4>
            </div>
            <p class="text-muted small mb-0 mt-1" style="color: #35567f !important;">Gerenciamento de sócios, carteirinhas com QR Code, mensalidades e eventos.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-sm rounded-pill px-3 fw-semibold" style="background: linear-gradient(135deg, #0a2f63 0%, #0d4aa4 46%, #1b6de2 100%); border: 1px solid #0d4aa4; color: #fff; box-shadow: 0 8px 18px rgba(13, 61, 143, 0.18);">
                <i class="fa-solid fa-globe me-1"></i> Ver Portal Público
            </a>
            <a href="/logout" class="btn btn-sm rounded-pill px-3 fw-semibold" style="background: rgba(13, 61, 143, 0.06); border: 1px solid rgba(13,61,143,0.25); color: #123d78;">
                <i class="fa-solid fa-power-off me-1"></i> Sair
            </a>
        </div>
    </div>

    <hr class="my-3 opacity-25" style="border-color: rgba(17, 17, 17, 0.15);">

    <ul class="nav nav-pills gap-2 flex-wrap">
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'dashboard' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin" style="<%= activeAdminTab === 'dashboard' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-chart-pie me-1"></i> Visão Geral
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'associados' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/associados" style="<%= activeAdminTab === 'associados' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-users me-1"></i> Lista de Associados
                <span class="badge <%= activeAdminTab === 'associados' ? 'bg-white text-primary' : 'bg-dark' %> ms-1"><%= totalAssociados %></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'mensalidades' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/mensalidades" style="<%= activeAdminTab === 'mensalidades' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-receipt me-1"></i> Mensalidades
                <span class="badge <%= activeAdminTab === 'mensalidades' ? 'bg-white text-primary' : 'bg-dark' %> ms-1"><%= totalMensalidades %></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'carteirinhas' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/carteirinhas" style="<%= activeAdminTab === 'carteirinhas' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-id-card me-1"></i> Carteirinhas & QR
                <span class="badge <%= activeAdminTab === 'carteirinhas' ? 'bg-white text-primary' : 'bg-dark' %> ms-1"><%= totalCarteirinhas %></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'comunicacao' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/comunicacao" style="<%= activeAdminTab === 'comunicacao' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-comment-sms me-1"></i> SMS Comunica
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'conteudo' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/conteudo" style="<%= activeAdminTab === 'conteudo' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-panorama me-1"></i> Conteúdo
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link <%= activeAdminTab === 'eventos' ? 'active bg-primary' : 'bg-light text-dark' %> fw-semibold rounded-pill px-3 py-2" href="/admin/eventos" style="<%= activeAdminTab === 'eventos' ? 'background: #0d3d8f; border: 1px solid #0d3d8f; color: #fff;' : 'background-color: #ffffff; color: #111111; border: 1px solid #d9d9d9;' %>">
                <i class="fa-solid fa-calendar-days me-1"></i> Eventos
                <span class="badge <%= activeAdminTab === 'eventos' ? 'bg-white text-primary' : 'bg-dark' %> ms-1"><%= totalEventos %></span>
            </a>
        </li>
    </ul>
</div>
