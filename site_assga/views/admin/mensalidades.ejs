<%- include('../layout/header') %>

<div class="container py-2">
    <%- include('nav_tabs') %>

    <!-- Cabeçalho e Ações -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Controle Financeiro de Mensalidades</h4>
                <p class="text-muted small mb-0">Gestão das contribuições sociais e confirmação de pagamentos PIX.</p>
            </div>
            <div>
                <button type="button" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovaMensalidade">
                    <i class="fa-solid fa-plus me-1"></i> Lançar Mensalidade
                </button>
            </div>
        </div>

        <hr class="my-3 opacity-25">

        <!-- Filtros -->
        <form method="get" action="/admin/mensalidades" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">Status: Todos</option>
                    <option value="Pago" <%= statusFiltro === 'Pago' ? 'selected' : '' %>>Apenas Pagas</option>
                    <option value="Pendente" <%= statusFiltro === 'Pendente' ? 'selected' : '' %>>Apenas Pendentes</option>
                    <option value="Atrasado" <%= statusFiltro === 'Atrasado' ? 'selected' : '' %>>Apenas Atrasadas</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="mes" class="form-select">
                    <option value="">Mês: Todos</option>
                    <% for(let m = 1; m <= 12; m++) { %>
                    <option value="<%= m %>" <%= mesFiltro == m ? 'selected' : '' %>>Mês <%= String(m).padStart(2, '0') %></option>
                    <% } %>
                </select>
            </div>
            <div class="col-md-3">
                <select name="ano" class="form-select">
                    <option value="2026" <%= anoFiltro == 2026 ? 'selected' : '' %>>2026</option>
                    <option value="2025" <%= anoFiltro == 2025 ? 'selected' : '' %>>2025</option>
                    <option value="2024" <%= anoFiltro == 2024 ? 'selected' : '' %>>2024</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100 fw-semibold">Filtrar</button>
                <% if (statusFiltro || mesFiltro) { %>
                <a href="/admin/mensalidades" class="btn btn-outline-secondary" title="Limpar Filtros"><i class="fa-solid fa-xmark"></i></a>
                <% } %>
            </div>
        </form>
    </div>

    <!-- Tabela de Mensalidades -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Associado</th>
                        <th>Matrícula</th>
                        <th>Categoria</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Ações</th>
                        <th>Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (mensalidades && mensalidades.length > 0) { %>
                        <% mensalidades.forEach(function(m) { %>
                        <% const assoc = associadosMap[m.associado_id]; %>
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark"><%= assoc ? assoc.nome : 'Associado #' + m.associado_id %></div>
                                <% if (m.observacoes) { %>
                                <div class="text-muted small" style="max-width: 250px;"><%= m.observacoes %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border font-monospace"><%= assoc ? assoc.matricula : '-' %></span>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-2"><%= assoc ? assoc.categoria : '-' %></span>
                            </td>
                            <td>
                                <% if (m.status === 'Pago') { %>
                                <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-check me-1"></i> Pago</span>
                                <% } else if (m.status === 'Pendente') { %>
                                <span class="badge bg-warning text-dark px-3 py-2"><i class="fa-solid fa-clock me-1"></i> Pendente</span>
                                <% } else { %>
                                <span class="badge bg-danger px-3 py-2"><i class="fa-solid fa-triangle-exclamation me-1"></i> <%= m.status %></span>
                                <% } %>
                            </td>
                            <td class="text-end pe-4">
                                <form method="post" action="/admin/mensalidades/<%= m.id %>/status" class="d-inline">
                                    <% if (m.status === 'Pago') { %>
                                    <input type="hidden" name="novoStatus" value="Pendente">
                                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-semibold" title="Marcar como Pendente">
                                        <i class="fa-solid fa-rotate-left me-1"></i> Estornar
                                    </button>
                                    <% } else { %>
                                    <input type="hidden" name="novoStatus" value="Pago">
                                    <button type="submit" class="btn btn-sm btn-success fw-bold px-3" title="Confirmar Recebimento">
                                        <i class="fa-solid fa-check me-1"></i> Dar Baixa
                                    </button>
                                    <% } %>
                                </form>
                            </td>
                            <td class="fw-bold <%= m.status === 'Pago' ? 'text-success' : 'text-danger' %>">
                                R$ <%= Number(m.valor).toFixed(2).replace('.', ',') %>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fa-solid fa-receipt display-6 d-block mb-3 opacity-50"></i>
                                Nenhuma mensalidade encontrada com os critérios informados.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Novo Lançamento de Mensalidade -->
<div class="modal fade" id="modalNovaMensalidade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Lançar Nova Mensalidade</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" action="/admin/mensalidades/novo">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Selecione o Associado *</label>
                        <select name="associado_id" class="form-select" required>
                            <% associados.forEach(function(s) { %>
                            <option value="<%= s.id %>"><%= s.matricula %> - <%= s.nome %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Mês de Referência *</label>
                            <select name="mes_referencia" class="form-select" required>
                                <% for(let m = 1; m <= 12; m++) { %>
                                <option value="<%= m %>" <%= m === 9 ? 'selected' : '' %>>Mês <%= String(m).padStart(2, '0') %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Ano *</label>
                            <input type="number" name="ano_referencia" class="form-control" value="2026" required>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Valor (R$) *</label>
                            <input type="number" step="0.50" name="valor" class="form-control" value="25.00" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Método</label>
                            <select name="metodo" class="form-select">
                                <option value="PIX">PIX</option>
                                <option value="Dinheiro">Dinheiro</option>
                                <option value="Transferência">Transferência</option>
                                <option value="Cartão">Cartão</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Status Inicial</label>
                        <select name="status" class="form-select">
                            <option value="Pago">Pago (Baixa imediata)</option>
                            <option value="Pendente">Pendente (Aguardando pagamento)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Observações / Código da Transação</label>
                        <input type="text" name="observacoes" class="form-control" placeholder="Opcional">
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">Salvar Lançamento</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
