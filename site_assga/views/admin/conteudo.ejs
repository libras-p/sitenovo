<%- include('../layout/header') %>
<% const listaDiretoria = typeof membrosDiretoria !== 'undefined' && Array.isArray(membrosDiretoria) ? membrosDiretoria : []; %>
<% const listaModalidades = typeof modalidades !== 'undefined' && Array.isArray(modalidades) ? modalidades : []; %>
<% const listaCapitulos = typeof capitulosEstatuto !== 'undefined' && Array.isArray(capitulosEstatuto) ? capitulosEstatuto : []; %>

<div class="container py-2">
    <%- include('nav_tabs') %>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-panorama me-2"></i>Conteúdo do Portal</h4>
                <p class="text-muted small mb-0">Gerencie os destaques visuais e as notícias em destaque na página inicial.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-images me-2"></i>Momentos da ASSGA</h5>
                    <button type="button" class="btn btn-sm btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#modalNovoMomento">
                        <i class="fa-solid fa-plus me-1"></i> Novo
                    </button>
                </div>

                <% if (momentosAssga && momentosAssga.length > 0) { %>
                    <div class="d-grid gap-3">
                        <% momentosAssga.forEach(function(item) { %>
                        <div class="border rounded-4 p-3" style="background: linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%); border-color: rgba(13,61,143,0.12) !important;">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-4">
                                    <img src="<%= item.imagem %>" alt="<%= item.titulo %>" class="img-fluid rounded-3 w-100" style="height: 110px; object-fit: cover;">
                                </div>
                                <div class="col-md-8">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <span class="badge bg-warning text-dark mb-2"><%= item.badge %></span>
                                            <h6 class="fw-bold text-dark mb-1"><%= item.titulo %></h6>
                                        </div>
                                        <form method="post" action="/admin/conteudo/momento/<%= item.id %>/excluir" onsubmit="return confirm('Remover este momento do portal?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <p class="small text-muted mb-0"><%= item.subtitulo %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="border rounded-4 p-4 text-center bg-light" style="border-style: dashed; border-color: rgba(13,61,143,0.18) !important;">
                        <i class="fa-solid fa-image display-6 mb-2 text-primary opacity-75"></i>
                        <h6 class="fw-bold text-primary mb-2">Nenhum momento cadastrado</h6>
                        <p class="small text-muted mb-0">Clique em “Novo” para adicionar o primeiro momento da ASSGA.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-newspaper me-2"></i>Notícias em Destaque</h5>
                    <button type="button" class="btn btn-sm btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#modalNovaNoticia">
                        <i class="fa-solid fa-plus me-1"></i> Nova
                    </button>
                </div>

                <% if (noticias && noticias.length > 0) { %>
                    <div class="d-grid gap-3">
                        <% noticias.forEach(function(noticia) { %>
                        <div class="border rounded-4 p-3" style="background: linear-gradient(180deg, #fffdf7 0%, #fff6df 100%); border-color: rgba(255, 190, 0, 0.18) !important;">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-4">
                                    <img src="<%= noticia.imagem %>" alt="<%= noticia.titulo %>" class="img-fluid rounded-3 w-100" style="height: 110px; object-fit: cover;">
                                </div>
                                <div class="col-md-8">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <span class="badge bg-warning text-dark mb-2"><%= noticia.data %></span>
                                            <h6 class="fw-bold text-dark mb-1"><%= noticia.titulo %></h6>
                                        </div>
                                        <form method="post" action="/admin/conteudo/noticia/<%= noticia.id %>/excluir" onsubmit="return confirm('Remover esta notícia do destaque?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <p class="small text-muted mb-0"><%= noticia.conteudo %></p>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="border rounded-4 p-4 text-center bg-light" style="border-style: dashed; border-color: rgba(255, 190, 0, 0.28) !important;">
                        <i class="fa-solid fa-newspaper display-6 mb-2 text-warning opacity-75"></i>
                        <h6 class="fw-bold text-warning mb-2">Nenhuma notícia em destaque cadastrada</h6>
                        <p class="small text-muted mb-0">Clique em “Nova” para publicar a primeira notícia do portal.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-handshake-angle me-2"></i>Parceiros e Apoiadores</h5>
            <button type="button" class="btn btn-sm btn-success rounded-pill" data-bs-toggle="modal" data-bs-target="#modalNovoParceiro">
                <i class="fa-solid fa-plus me-1"></i> Novo Parceiro
            </button>
        </div>

        <% if (parceirosApoiadores && parceirosApoiadores.length > 0) { %>
            <div class="row g-3">
                <% parceirosApoiadores.forEach(function(parceiro) { %>
                    <div class="col-md-3">
                        <div class="border rounded-4 p-3 h-100 d-flex justify-content-between align-items-center gap-2" style="background: #f4fbf0; border-color: rgba(16, 129, 89, 0.18) !important;">
                            <div class="d-flex align-items-center gap-2">
                                <% if (parceiro.imagem) { %>
                                    <img src="<%= parceiro.imagem %>" alt="<%= parceiro.nome %>" class="rounded-2 border" style="width: 42px; height: 42px; object-fit: cover; background: white;">
                                <% } %>
                                <div>
                                    <div class="fw-bold text-dark small"><%= parceiro.nome %></div>
                                    <% if (parceiro.link && parceiro.link !== '#') { %>
                                        <a href="<%= parceiro.link %>" target="_blank" rel="noopener" class="small text-success text-decoration-none">Link</a>
                                    <% } else { %>
                                        <span class="small text-muted">Sem link</span>
                                    <% } %>
                                </div>
                            </div>
                            <form method="post" action="/admin/conteudo/parceiro/<%= parceiro.id %>/excluir" onsubmit="return confirm('Remover este parceiro/apoiador?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Excluir">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-4 text-muted">
                <i class="fa-solid fa-handshake-angle display-6 mb-2 opacity-50"></i>
                <p class="mb-0">Nenhum parceiro ou apoiador cadastrado.</p>
            </div>
        <% } %>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mt-4">
        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-people-group me-2"></i>Diretoria pública</h5>
        <form method="post" action="/admin/conteudo/diretoria/novo" class="row g-2 mb-4">
            <div class="col-md-3"><input name="nome" class="form-control" placeholder="Nome" required></div>
            <div class="col-md-3"><input name="cargo" class="form-control" placeholder="Cargo" required></div>
            <div class="col-md-2"><input name="gestao" class="form-control" placeholder="Gestão"></div>
            <div class="col-md-2"><input name="email" type="email" class="form-control" placeholder="E-mail"></div>
            <div class="col-md-2"><input name="telefone" class="form-control" placeholder="Telefone"></div>
            <div class="col-md-8"><input name="foto_url" type="url" class="form-control" placeholder="URL da foto"></div>
            <div class="col-md-4"><input name="bio" class="form-control" placeholder="Biografia"></div>
            <div class="col-12"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-plus me-1"></i>Cadastrar membro</button></div>
        </form>
        <% if (listaDiretoria.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Nome</th><th>Cargo</th><th>Gestão</th><th>E-mail</th><th></th></tr></thead>
                <tbody>
                    <% listaDiretoria.forEach(function(membro) { %>
                    <tr>
                        <td><%= membro.nome %></td><td><%= membro.cargo %></td><td><%= membro.gestao %></td><td><%= membro.email %></td>
                        <td class="text-end"><form method="post" action="/admin/conteudo/diretoria/<%= membro.id %>/excluir" onsubmit="return confirm('Remover este membro da diretoria?');"><button class="btn btn-sm btn-outline-danger" title="Remover"><i class="fa-solid fa-trash"></i></button></form></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %><p class="small text-muted mb-0">Nenhum membro da diretoria cadastrado.</p><% } %>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mt-4">
        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-trophy me-2"></i>Modalidades esportivas</h5>
        <form method="post" action="/admin/conteudo/modalidade/novo" class="row g-2 mb-4">
            <div class="col-md-3"><input name="nome" class="form-control" placeholder="Modalidade" required></div>
            <div class="col-md-2"><input name="categoria" class="form-control" placeholder="Categoria"></div>
            <div class="col-md-2"><input name="icone" class="form-control" placeholder="Ícone (ex.: fa-futbol)"></div>
            <div class="col-md-2"><input name="dias_treino" class="form-control" placeholder="Dias/horários"></div>
            <div class="col-md-3"><input name="local_treino" class="form-control" placeholder="Local"></div>
            <div class="col-md-3"><input name="responsavel" class="form-control" placeholder="Responsável"></div>
            <div class="col-md-7"><input name="descricao" class="form-control" placeholder="Descrição" required></div>
            <div class="col-md-2 d-flex align-items-center"><div class="form-check"><input name="ativa" type="checkbox" class="form-check-input" id="modalidadeAtiva" checked><label class="form-check-label" for="modalidadeAtiva">Ativa</label></div></div>
            <div class="col-12"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-plus me-1"></i>Cadastrar modalidade</button></div>
        </form>
        <% if (listaModalidades.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Modalidade</th><th>Categoria</th><th>Treinos</th><th>Local</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    <% listaModalidades.forEach(function(modalidade) { %>
                    <tr>
                        <td><%= modalidade.nome %></td><td><%= modalidade.categoria %></td><td><%= modalidade.dias_treino %></td><td><%= modalidade.local_treino %></td><td><%= modalidade.ativa ? 'Ativa' : 'Inativa' %></td>
                        <td class="text-end"><form method="post" action="/admin/conteudo/modalidade/<%= modalidade.id %>/excluir" onsubmit="return confirm('Remover esta modalidade?');"><button class="btn btn-sm btn-outline-danger" title="Remover"><i class="fa-solid fa-trash"></i></button></form></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %><p class="small text-muted mb-0">Nenhuma modalidade cadastrada.</p><% } %>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mt-4">
        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-scale-balanced me-2"></i>Estatuto social</h5>
        <form method="post" action="/admin/conteudo/estatuto/capitulo/novo" class="row g-2 mb-4">
            <div class="col-md-2"><input name="numero" type="number" min="1" class="form-control" placeholder="Nº cap. "></div>
            <div class="col-md-4"><input name="titulo" class="form-control" placeholder="Título do capítulo" required></div>
            <div class="col-md-2"><input name="artigo_numero" type="number" min="1" class="form-control" placeholder="Nº artigo"></div>
            <div class="col-md-4"><input name="texto" class="form-control" placeholder="Texto do primeiro artigo" required></div>
            <div class="col-md-10"><input name="paragrafo_unico" class="form-control" placeholder="Parágrafo único (opcional)"></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Cadastrar</button></div>
        </form>
        <% if (listaCapitulos.length > 0) { %>
            <% listaCapitulos.forEach(function(capitulo) { %>
            <div class="border rounded-3 p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                    <h6 class="fw-bold mb-0">Capítulo <%= capitulo.numero %>: <%= capitulo.titulo %></h6>
                    <form method="post" action="/admin/conteudo/estatuto/<%= capitulo.id %>/excluir" onsubmit="return confirm('Remover este capítulo e seus artigos?');"><button class="btn btn-sm btn-outline-danger" title="Remover capítulo"><i class="fa-solid fa-trash"></i></button></form>
                </div>
                <% capitulo.artigos.forEach(function(artigo) { %>
                <div class="d-flex justify-content-between align-items-start gap-2 border-top py-2">
                    <p class="small mb-0"><strong>Art. <%= artigo.numero %>º</strong> <%= artigo.texto %><% if (artigo.paragrafo_unico) { %><br><span class="text-muted">Parágrafo único: <%= artigo.paragrafo_unico %></span><% } %></p>
                    <form method="post" action="/admin/conteudo/estatuto/<%= capitulo.id %>/artigo/<%= artigo.id %>/excluir" onsubmit="return confirm('Remover este artigo?');"><button class="btn btn-sm btn-outline-danger" title="Remover artigo"><i class="fa-solid fa-trash"></i></button></form>
                </div>
                <% }); %>
                <form method="post" action="/admin/conteudo/estatuto/<%= capitulo.id %>/artigo/novo" class="row g-2 mt-2">
                    <div class="col-md-2"><input name="numero" type="number" min="1" class="form-control" placeholder="Nº artigo"></div>
                    <div class="col-md-7"><input name="texto" class="form-control" placeholder="Texto do artigo" required></div>
                    <div class="col-md-2"><input name="paragrafo_unico" class="form-control" placeholder="Parágrafo único"></div>
                    <div class="col-md-1"><button class="btn btn-outline-primary w-100" type="submit" title="Adicionar artigo"><i class="fa-solid fa-plus"></i></button></div>
                </form>
            </div>
            <% }); %>
        <% } else { %><p class="small text-muted mb-0">Nenhum capítulo do estatuto cadastrado.</p><% } %>
    </div>
</div>

<div class="modal fade" id="modalNovoParceiro" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-handshake-angle me-2"></i>Novo Parceiro / Apoiador</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" action="/admin/conteudo/parceiro/novo">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Imagem *</label>
                        <input type="url" name="imagem" class="form-control" placeholder="https://exemplo.com/logo.png" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nome *</label>
                        <input type="text" name="nome" class="form-control" placeholder="Ex: United" required>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Link</label>
                        <input type="url" name="link" class="form-control" placeholder="https://exemplo.com.br">
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovoMomento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-images me-2"></i>Novo Momento da ASSGA</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" action="/admin/conteudo/momento/novo">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Título *</label>
                            <input type="text" name="titulo" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Badge *</label>
                            <input type="text" name="badge" class="form-control" value="Comunidade & Liderança" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Subtítulo *</label>
                            <textarea name="subtitulo" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">URL da Imagem *</label>
                            <input type="url" name="imagem" class="form-control" value="/imagens/Assga_foto.jpg" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Salvar Momento</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNovaNoticia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-warning text-dark border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-newspaper me-2"></i>Nova Notícia em Destaque</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" action="/admin/conteudo/noticia/novo">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Título *</label>
                            <input type="text" name="titulo" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Data *</label>
                            <input type="text" name="data" class="form-control" value="<%= new Date().toLocaleDateString('pt-BR') %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">URL da Imagem *</label>
                            <input type="url" name="imagem" class="form-control" value="/imagens/foto1.jpg" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Conteúdo *</label>
                            <textarea name="conteudo" class="form-control" rows="4" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Publicar Notícia</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
