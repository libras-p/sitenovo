<%- include('../layout/header') %>

<div class="container">
    <!-- Hero Banner com Identidade Visual -->
    <div class="p-5 mb-4 rounded-4 border shadow-sm" style="background: linear-gradient(135deg, #003366 0%, #004aad 100%); color: white;">
        <div class="container-fluid py-3">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fa-solid fa-hands-asl-interpreting me-1"></i> Comunidade Surda Potiguar
                    </span>
                    <h1 class="display-5 fw-bold text-white mb-3">ASSGA - Associação dos Surdos</h1>
                    <p class="col-md-10 fs-5 text-light opacity-90">
                        Promovendo inclusão, cidadania, direitos linguísticos em LIBRAS e excelência no desporto dos surdos em São Gonçalo do Amarante e região.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a href="/carteirinha" class="btn btn-warning btn-lg fw-bold px-4 shadow-sm">
                            <i class="fa-solid fa-id-card me-2"></i> Emitir Carteirinha
                        </a>
                        <a href="/pagamento" class="btn btn-outline-light btn-lg px-4 shadow-sm">
                            <i class="fa-brands fa-pix me-2"></i> Mensalidade PIX
                        </a>
                        <a href="/esportiva" class="btn btn-light btn-lg px-4 text-primary fw-semibold shadow-sm">
                            <i class="fa-solid fa-trophy me-2"></i> Esportes
                        </a>
                        <a href="/contato" class="btn btn-primary btn-lg px-4 fw-bold shadow-sm" style="background: linear-gradient(135deg, #1b64d8 0%, #0b2e6b 100%); border: none;">
                            <i class="fa-solid fa-envelope me-2"></i> Contato
                        </a>
                        <a href="/voluntario" class="btn btn-success btn-lg px-4 fw-bold shadow-sm" style="background: linear-gradient(135deg, #1bbf7a 0%, #0d7d4c 100%); border: none;">
                            <i class="fa-solid fa-handshake-angle me-2"></i> Voluntário
                        </a>
                    </div>
                </div>
                <div class="col-lg-4 text-center mt-4 mt-lg-0">
                    <div class="card bg-white text-dark p-3 rounded-4 shadow border-0">
                        <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-bullhorn me-1"></i> Comunicado Oficial</h6>
                        <p class="small mb-3 text-muted">Acesse a emissão e impressão da carteirinha oficial de sócio com validação eletrônica por QR Code.</p>
                        <% if (user) { %>
                            <a href="/area-associado" class="btn btn-primary btn-sm fw-bold">Meu Painel de Associado</a>
                        <% } else { %>
                            <a href="/login" class="btn btn-primary btn-sm fw-bold">Acessar Área do Associado</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de Destaques em Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-trophy fs-4"></i>
                    </div>
                    <h5 class="card-title fw-bold text-primary">Desporto de Surdos</h5>
                    <p class="card-text text-muted">Modalidades como futsal masculino e feminino, voleibol e atletismo, com treinos regulares e participação em torneios estaduais e nacionais.</p>
                    <a href="/esportiva" class="btn btn-link text-primary p-0 fw-bold text-decoration-none">Conhecer Modalidades &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-scale-balanced fs-4"></i>
                    </div>
                    <h5 class="card-title fw-bold text-dark">Estatuto Social</h5>
                    <p class="card-text text-muted">Conheça os direitos e deveres dos associados, estrutura da diretoria, conselho fiscal e objetivos estatutários da entidade.</p>
                    <a href="/estatuto" class="btn btn-link text-dark p-0 fw-bold text-decoration-none">Ler Estatuto &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-id-card fs-4"></i>
                    </div>
                    <h5 class="card-title fw-bold text-success">Carteirinha Digital</h5>
                    <p class="card-text text-muted">Identificação oficial com código de autenticação, comprovante de filiação e modelo pronto para impressão frente e verso.</p>
                    <a href="/carteirinha" class="btn btn-link text-success p-0 fw-bold text-decoration-none">Ver Carteirinha &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Slider de Fotos da ASSGA -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-primary mb-0"><i class="fa-solid fa-images me-2"></i>Momentos da ASSGA</h3>
            <a href="/eventos" class="btn btn-outline-primary btn-sm fw-bold">Ver Todos os Eventos</a>
        </div>
        <div id="eventosSlider" class="carousel slide carousel-fade shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <% momentosAssga.forEach(function(item, index) { %>
                <button type="button" data-bs-target="#eventosSlider" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-current="<%= index === 0 ? 'true' : 'false' %>" aria-label="Foto <%= index + 1 %>"></button>
                <% }); %>
            </div>
            <div class="carousel-inner">
                <% momentosAssga.forEach(function(item, index) { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                    <div class="d-flex align-items-end position-relative" style="height: 380px; background-color: #001f3f;">
                        <img src="<%= item.imagem %>" alt="<%= item.titulo %>" class="w-100 h-100 object-fit-cover opacity-75">
                        <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(transparent, rgba(0,0,0,0.85)); color: white;">
                            <span class="badge bg-warning text-dark mb-2"><%= item.badge %></span>
                            <h4 class="fw-bold mb-1"><%= item.titulo %></h4>
                            <p class="small mb-0 text-light"><%= item.subtitulo %></p>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#eventosSlider" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#eventosSlider" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Próximo</span>
            </button>
        </div>
    </div>

    <!-- Seção de Notícias Recentes -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <h3 class="fw-bold text-primary mb-4"><i class="fa-solid fa-newspaper me-2"></i>Notícias em Destaque</h3>
        </div>
        <% noticias.forEach(function(noticia) { %>
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="row g-0 h-100">
                    <div class="col-md-5">
                        <img src="<%= noticia.imagem %>" class="img-fluid h-100 w-100 object-fit-cover" alt="<%= noticia.titulo %>" style="min-height: 180px;">
                    </div>
                    <div class="col-md-7">
                        <div class="card-body p-4 d-flex flex-column h-100">
                            <span class="badge bg-warning text-dark mb-2 align-self-start"><%= noticia.data %></span>
                            <h5 class="fw-bold text-dark mb-2"><%= noticia.titulo %></h5>
                            <p class="card-text text-muted small flex-grow-1"><%= noticia.conteudo %></p>
                            <a href="/eventos" class="btn btn-outline-primary btn-sm fw-semibold align-self-start mt-2">Saiba Mais</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<%- include('../layout/footer') %>
