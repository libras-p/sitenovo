<%- include('../layout/header') %>

<div class="container py-3">
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase">Desporto de Surdos</span>
        <h2 class="fw-bold text-primary mt-2">Modalidades Esportivas ASSGA</h2>
        <p class="text-muted">Filiada à CBDS e FENEIS: promovendo saúde, integração e alto rendimento.</p>
    </div>

    <div class="row g-4">
        <% modalidades.forEach(function(mod) { %>
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-primary text-warning rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px; min-width: 56px;">
                        <i class="fa-solid <%= mod.icone %> fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0"><%= mod.nome %></h4>
                        <span class="badge bg-light text-primary border"><%= mod.categoria %></span>
                    </div>
                </div>

                <p class="text-secondary mb-3"><%= mod.descricao %></p>

                <div class="bg-light p-3 rounded-3 small mt-auto">
                    <div class="mb-1"><strong><i class="fa-solid fa-clock text-primary me-2"></i>Horários:</strong> <%= mod.dias_treino %></div>
                    <div class="mb-1"><strong><i class="fa-solid fa-location-dot text-danger me-2"></i>Local:</strong> <%= mod.local_treino %></div>
                    <div><strong><i class="fa-solid fa-user text-success me-2"></i>Responsável:</strong> <%= mod.responsavel %></div>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<%- include('../layout/footer') %>
