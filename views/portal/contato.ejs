<%- include('../layout/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5" style="background: linear-gradient(135deg, #ffffff 0%, #edf5ff 100%); border: 1px solid rgba(13,61,143,0.12) !important;">
                <div class="text-center mb-4">
                    <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fa-solid fa-envelope-open-text me-2"></i>Fale Conosco
                    </span>
                    <h1 class="fw-bold text-primary mb-2">Entre em contato com a ASSGA</h1>
                    <p class="text-muted mb-0">Sua mensagem será recebida pela equipe da associação e respondida em breve.</p>
                </div>

                <form method="post" action="/contato">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-primary mb-1">Nome ( seu nome completo )</label>
                        <input type="text" name="nome" class="form-control border-primary-subtle" placeholder="Seu nome completo" required>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-primary mb-1">E-mail ( seu@email.com )</label>
                            <input type="email" name="email" class="form-control border-primary-subtle" placeholder="seu@email.com" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-primary mb-1">Telefone/celular (84)9999-0000</label>
                            <input type="tel" name="telefone" class="form-control border-primary-subtle" placeholder="(84)9999-0000" required>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label small fw-bold text-primary mb-1">Mensagem</label>
                        <textarea name="mensagem" class="form-control border-primary-subtle" rows="5" placeholder="Escreva sua mensagem aqui.." required></textarea>
                    </div>

                    <div class="d-flex justify-content-center mt-4">
                        <button type="submit" class="btn btn-primary fw-bold px-4 rounded-pill">
                            <i class="fa-solid fa-paper-plane me-2"></i>Enviar mensagem
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
