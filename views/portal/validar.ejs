<%- include('../layout/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center">
                <% if (valida) { %>
                <div class="text-success display-4 mb-3">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h3 class="fw-bold text-success mb-2">Carteirinha Válida e Autêntica</h3>
                <p class="text-muted small mb-4">Registro verificado com sucesso na base oficial da ASSGA.</p>
                <% } else { %>
                <div class="text-danger display-4 mb-3">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <h3 class="fw-bold text-danger mb-2">Carteirinha Pendente ou Vencida</h3>
                <p class="text-muted small mb-4">O associado precisa regularizar sua situação junto à secretaria.</p>
                <% } %>

                <div class="bg-light p-4 rounded-4 text-start small mb-4 border">
                    <div class="mb-2"><strong>Associado:</strong> <%= associado.nome %></div>
                    <div class="mb-2"><strong>Matrícula:</strong> <%= associado.matricula %></div>
                    <div class="mb-2"><strong>Categoria:</strong> <%= associado.categoria %></div>
                    <div class="mb-2"><strong>Validade:</strong> <%= carteirinha.data_validade.split('-').reverse().join('/') %></div>
                    <div class="mb-2"><strong>Status do Sócio:</strong> <span class="badge rounded-pill px-3 py-2 fw-bold border border-2 <%= associado.status === 'Ativo' ? 'bg-success border-success text-white' : associado.status === 'Pendente' ? 'bg-warning border-warning text-dark' : 'bg-danger border-danger text-white' %>"><%= associado.status %></span></div>
                    <div class="mb-0 text-muted"><strong>Autenticação:</strong> <span class="font-monospace"><%= carteirinha.codigo_autenticacao %></span></div>
                </div>

                <div class="text-muted small">
                    Consulta oficial realizada em <%= new Date().toLocaleDateString('pt-BR') %>.
                    <br>
                    <strong>ASSGA - Associação dos Surdos de São Gonçalo do Amarante / RN</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
