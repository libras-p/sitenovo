<!-- Sub-navegação do Painel Administrativo ASSGA -->
<div class="mb-4" style="background: linear-gradient(180deg, #dfeafc 0%, #d4e1f7 100%); border: 1px solid #bfd1f0; border-radius: 18px; padding: 10px 12px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.7);">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex flex-wrap align-items-center gap-2" style="overflow-x: auto; white-space: nowrap;">
            <a href="/admin" class="nav-tab-pill <%= activeAdminTab === 'dashboard' ? 'active' : '' %>" style="<%= activeAdminTab === 'dashboard' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-gauge"></i></span>
                <span>Visão Geral</span>
            </a>

            <a href="/admin/associados" class="nav-tab-pill <%= activeAdminTab === 'associados' ? 'active' : '' %>" style="<%= activeAdminTab === 'associados' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-users"></i></span>
                <span>Lista de Associados</span>
                <span class="tab-count"><%= totalAssociados %></span>
            </a>

            <a href="/admin/mensalidades" class="nav-tab-pill <%= activeAdminTab === 'mensalidades' ? 'active' : '' %>" style="<%= activeAdminTab === 'mensalidades' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-receipt"></i></span>
                <span>Mensalidades</span>
                <span class="tab-count"><%= totalMensalidades %></span>
            </a>

            <a href="/admin/carteirinhas" class="nav-tab-pill <%= activeAdminTab === 'carteirinhas' ? 'active' : '' %>" style="<%= activeAdminTab === 'carteirinhas' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-id-card"></i></span>
                <span>Carteirinhas &amp; QR</span>
                <span class="tab-count"><%= totalCarteirinhas %></span>
            </a>

            <a href="/admin/comunicacao" class="nav-tab-pill <%= activeAdminTab === 'comunicacao' ? 'active' : '' %>" style="<%= activeAdminTab === 'comunicacao' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-comment-sms"></i></span>
                <span>SMS Comunica</span>
            </a>

            <a href="/admin/conteudo" class="nav-tab-pill <%= activeAdminTab === 'conteudo' ? 'active' : '' %>" style="<%= activeAdminTab === 'conteudo' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-panorama"></i></span>
                <span>Conteúdo</span>
            </a>

            <a href="/admin/eventos" class="nav-tab-pill <%= activeAdminTab === 'eventos' ? 'active' : '' %>" style="<%= activeAdminTab === 'eventos' ? 'background: linear-gradient(135deg, #0b3c8d 0%, #0d4aa4 100%); color: #fff; box-shadow: 0 6px 18px rgba(13, 61, 143, 0.2);' : 'background: rgba(255,255,255,0.55); color: #123d78;' %>">
                <span class="tab-icon"><i class="fa-solid fa-calendar-days"></i></span>
                <span>Eventos</span>
                <span class="tab-count"><%= totalEventos %></span>
            </a>
        </div>

        <a href="/admin/logout" class="admin-logout-btn">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Sair</span>
        </a>
    </div>
</div>

<style>
    .nav-tab-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 46px;
        padding: 0 16px 0 14px;
        border: 1px solid rgba(22, 52, 98, 0.18);
        border-radius: 999px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 1px 0 rgba(255,255,255,0.8);
    }

    .nav-tab-pill:hover {
        text-decoration: none;
        filter: brightness(0.98);
    }

    .tab-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: rgba(255,255,255,0.28);
        font-size: 12px;
    }

    .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 999px;
        background: #111827;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        line-height: 1;
    }

    .admin-logout-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid rgba(178, 38, 38, 0.35);
        border-radius: 999px;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 8px 18px rgba(220, 38, 38, 0.2);
        transition: all 0.2s ease;
    }

    .admin-logout-btn:hover {
        text-decoration: none;
        filter: brightness(1.04);
        color: #fff;
    }
</style>
