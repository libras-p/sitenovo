<%- include('../layout/header') %>
<% const eventosLista = typeof eventos !== 'undefined' && Array.isArray(eventos) ? eventos : []; %>

<div class="container py-2">
    <%- include('nav_tabs') %>

    <!-- Cabeçalho -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-calendar-check me-2"></i>Gestão de Eventos e Torneios</h4>
                <p class="text-muted small mb-0">Gerencie assembleias, campeonatos de futsal e encontros da comunidade surda.</p>
            </div>
            <div>
                <button type="button" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoEvento">
                    <i class="fa-solid fa-calendar-plus me-1"></i> Publicar Novo Evento
                </button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h5 class="fw-bold text-primary mb-1">Eventos cadastrados</h5>
                <p class="small text-muted mb-0"><%= eventosLista.length %> evento(s) no portal</p>
            </div>
        </div>

        <% if (eventosLista.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Evento</th>
                        <th>Tipo</th>
                        <th>Data</th>
                        <th>Local</th>
                        <th>LIBRAS</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% eventosLista.forEach(function(evento) { %>
                    <tr>
                        <td>
                            <div class="fw-bold"><%= evento.titulo %></div>
                            <div class="small text-muted"><%= evento.descricao %></div>
                        </td>
                        <td><%= evento.tipo %></td>
                        <td><%= new Date(evento.data_inicio).toLocaleString('pt-BR') %></td>
                        <td><%= evento.local %></td>
                        <td>
                            <% if (evento.libras_disponivel) { %>
                            <span class="badge bg-success">Disponível</span>
                            <% } else { %>
                            <span class="badge bg-secondary">Não informado</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <form method="post" action="/admin/eventos/<%= evento.id %>/excluir" onsubmit="return confirm('Excluir este evento?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir evento" aria-label="Excluir evento">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="border rounded-4 p-4 text-center bg-light" style="border-style: dashed;">
            <i class="fa-solid fa-calendar-xmark display-6 mb-2 text-muted"></i>
            <h6 class="fw-bold mb-1">Nenhum evento cadastrado</h6>
            <p class="small text-muted mb-0">Os eventos publicados aparecerão nesta lista.</p>
        </div>
        <% } %>
    </div>

</div>

<!-- Modal Novo Evento -->
<div class="modal fade" id="modalNovoEvento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-calendar-plus me-2"></i>Publicar Novo Evento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form method="post" action="/admin/eventos/novo">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Título do Evento *</label>
                            <input type="text" name="titulo" class="form-control" placeholder="Ex: Torneio Integração de Futsal" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Tipo de Evento *</label>
                            <select name="tipo" class="form-select" required>
                                <option value="Esportivo">Esportivo</option>
                                <option value="Cultural">Cultural</option>
                                <option value="Assembleia">Assembleia</option>
                                <option value="Comunitário">Comunitário</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Data e Horário de Início *</label>
                            <input type="datetime-local" name="data_inicio" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Local *</label>
                            <input type="text" name="local" class="form-control" placeholder="Ginásio ou sede" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Descrição Completa *</label>
                            <textarea name="descricao" class="form-control" rows="3" placeholder="Detalhes do evento, inscrições, regulamento..." required></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">URL da Imagem de Capa (Opcional)</label>
                            <input type="url" name="imagem_url" class="form-control" placeholder="https://...">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="libras_disponivel" id="checkLibras" checked>
                                <label class="form-check-label small fw-bold" for="checkLibras">
                                    Intérprete LIBRAS disponível
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Cadastrar Evento</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
