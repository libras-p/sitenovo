<%- include('../layout/header') %>

<div class="container py-2">
    <%- include('nav_tabs') %>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-comment-sms me-2"></i>Comunicação por SMS</h4>
                <p class="text-muted small mb-0">Envio em massa para associados ativos com telefone cadastrado.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold">
                    <i class="fa-solid fa-user-check me-1"></i> <%= destinatariosAtivos %> destinatários ativos
                </span>
                <span class="badge bg-success text-white rounded-pill px-3 py-2 fw-bold">
                    <i class="fa-solid fa-handshake-angle me-1"></i> <%= totalVoluntarios %> voluntários
                </span>
                <span class="badge bg-info text-white rounded-pill px-3 py-2 fw-bold">
                    <i class="fa-solid fa-envelope me-1"></i> <%= totalContatos %> contatos
                </span>
            </div>
        </div>

        <% if (typeof ultimaMensagem !== 'undefined' && ultimaMensagem) { %>
        <div class="alert alert-info small mb-3">
            <strong>Última mensagem:</strong> <%= ultimaMensagem %>
        </div>
        <% } %>

        <form method="post" action="/admin/comunicacao/enviar">
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Mensagem do SMS</label>
                <textarea name="mensagem" rows="5" maxlength="160" class="form-control" placeholder="Ex: Olá, a ASSGA informa..." required></textarea>
                <div class="form-text">Até 160 caracteres por mensagem.</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted">Destino</div>
                        <div class="fw-bold text-dark">Associados ativos</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted">Canal</div>
                        <div class="fw-bold text-dark">SMS em massa</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted">Status</div>
                        <div class="fw-bold text-success">Pronto para envio</div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-warning fw-bold px-4 py-3 rounded-pill shadow-sm">
                <i class="fa-solid fa-paper-plane me-2"></i> Enviar SMS para todos
            </button>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h5 class="fw-bold text-primary mb-1"><i class="fa-solid fa-envelope me-2"></i>Mensagens de Contato</h5>
                <p class="text-muted small mb-0">Mensagens recebidas do formulário de contato do portal.</p>
            </div>
        </div>

        <% if (contatos && contatos.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Mensagem</th>
                        <th>Data</th>
                    </tr>
                </thead>
                <tbody>
                    <% contatos.forEach(function(c) { %>
                    <tr>
                        <td class="fw-bold text-dark"><%= c.nome %></td>
                        <td><%= c.email %></td>
                        <td><%= c.telefone %></td>
                        <td style="max-width: 420px; white-space: normal;"><%= c.mensagem %></td>
                        <td class="text-muted"><%= new Date(c.criado_em).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                        <td class="text-end">
                            <form method="post" action="/admin/contatos/<%= c.id %>/excluir" onsubmit="return confirm('Deseja remover esta mensagem de contato?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir mensagem de contato">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="border rounded-4 p-4 text-center bg-light" style="border-style: dashed; border-color: rgba(13,61,143,0.18) !important;">
            <i class="fa-solid fa-envelope display-6 mb-3 text-info opacity-75"></i>
            <h6 class="fw-bold text-info mb-2">Nenhuma mensagem de contato</h6>
            <p class="small text-muted mb-0">Quando alguém mandar uma mensagem pelo formulário, ela aparecerá aqui.</p>
        </div>
        <% } %>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h5 class="fw-bold text-primary mb-1"><i class="fa-solid fa-handshake-angle me-2"></i>Voluntários Registrados</h5>
                <p class="text-muted small mb-0">Mensagens recebidas do formulário “Seja um Voluntário”.</p>
            </div>
        </div>

        <% if (voluntarios && voluntarios.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Idade</th>
                        <th>Mensagem</th>
                        <th>Data</th>
                    </tr>
                </thead>
                <tbody>
                    <% voluntarios.forEach(function(v) { %>
                    <tr>
                        <td class="fw-bold text-dark"><%= v.nome %></td>
                        <td><%= v.email %></td>
                        <td><%= v.telefone %></td>
                        <td><%= v.idade %></td>
                        <td style="max-width: 320px; white-space: normal;"> <%= v.mensagem %></td>
                        <td class="text-muted"><%= new Date(v.criado_em).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                        <td class="text-end">
                            <form method="post" action="/admin/voluntarios/<%= v.id %>/excluir" onsubmit="return confirm('Deseja remover este voluntário?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir voluntário">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="border rounded-4 p-4 text-center bg-light" style="border-style: dashed; border-color: rgba(13,61,143,0.18) !important;">
            <i class="fa-solid fa-handshake-angle display-6 mb-3 text-success opacity-75"></i>
            <h6 class="fw-bold text-success mb-2">Nenhum voluntário cadastrado</h6>
            <p class="small text-muted mb-0">Quando alguém preencher o formulário de voluntariado, a mensagem aparecerá aqui.</p>
        </div>
        <% } %>
    </div>
</div>

<%- include('../layout/footer') %>
